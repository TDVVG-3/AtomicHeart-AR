<Application x:Class="AtomicHeartAR.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#EEE9D8"/>
    <SolidColorBrush x:Key="Muted" Color="#A6AEA8"/>
    <SolidColorBrush x:Key="Red" Color="#E65043"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#292E2B"/><Setter Property="BorderBrush" Value="#414941"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#EEE9D8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Background" Value="{StaticResource Red}"/><Setter Property="BorderBrush" Value="{StaticResource Red}"/><Setter Property="Foreground" Value="#111511"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="16"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#151A17"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#3C463F"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="CaretBrush" Value="{StaticResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Application.Resources>
</Application>
